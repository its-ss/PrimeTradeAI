# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/primetrade_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=5000
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# One-time seed endpoint (set SEED_DONE=true after seeding to disable), Used to initiate/create db and its pre-definred rows 
SEED_SECRET="choose-a-random-secret"
SEED_DONE=false
